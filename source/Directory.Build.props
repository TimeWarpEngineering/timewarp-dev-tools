<Project>
  <!-- Import root Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Defaults for product projects. tools/dev-cli sets its own. -->
  <PropertyGroup Label="Project Defaults">
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageOutputPath>$(PackagesDirectory)</PackageOutputPath>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
  </PropertyGroup>

  <!-- Package metadata for NuGet publishing -->
  <PropertyGroup Label="Package Metadata">
    <Version>1.0.0-beta.1</Version>
    <Authors>TimeWarpEngineering</Authors>
    <PackageProjectUrl>https://timewarp.software/projects/timewarp-dev-tools/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TimeWarpEngineering/timewarp-dev-tools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Include common package files -->
  <ItemGroup Label="Package Content">
    <None Include="$(RepositoryRoot)assets/logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
