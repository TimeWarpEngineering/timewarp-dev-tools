<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Standalone TimeWarp DevTools host. Runs with dotnet run and no AppHost. Not a NuGet package.</Description>
    <AssemblyName>TimeWarp.DevTools.Host</AssemblyName>
    <RootNamespace>TimeWarp.DevTools.Host</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The host has no .razor file of its own, so the Web SDK would not add the framework web assets
         (_framework/blazor.web.js). The shell package sets this through buildTransitive; a project
         reference does not import that file. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host runs the mediator generator for the whole graph, including the shell's state handlers. -->
    <PackageReference Include="TimeWarp.Mediator" />
    <PackageReference Include="TimeWarp.Mediator.Generators" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\timewarp-dev-tools-shell\timewarp-dev-tools-shell.csproj" />
  </ItemGroup>
</Project>
