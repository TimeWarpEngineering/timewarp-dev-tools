<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>TimeWarp.DevTools.Hosting</Title>
    <Description>Aspire AppHost extension that adds a TimeWarp DevTools host as a run-mode-only resource linked from the dashboard.</Description>
    <PackageId>TimeWarp.DevTools.Hosting</PackageId>
    <AssemblyName>TimeWarp.DevTools.Hosting</AssemblyName>
    <RootNamespace>TimeWarp.DevTools.Hosting</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageTags>TimeWarp; DevTools; Aspire; Hosting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
